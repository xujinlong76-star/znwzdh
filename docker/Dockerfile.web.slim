# NavHub Web 前端镜像 —— 多阶段瘦身版（可选）
#
# 与 docker/Dockerfile.web 共用 scripts/vendor-web.mjs 的下载/overlay/prune 逻辑，
# 只改变依赖与运行产物分层，不再维护第二套上游拉取和覆盖流程。
# 默认镜像仍用 next start；本文件用 standalone + node server.js，保持可选形态。
#
# 用法（在仓库根）：
#   docker build -f docker/Dockerfile.web.slim -t navhub/web:slim .
#   docker run --rm -p 3000:3000 -e NAVHUB_STORAGE_BASE_URL=http://api:8787 navhub/web:slim
#
# 前提：apps/web-overlay/next.config.js 支持 NAVHUB_WEB_STANDALONE=1 生成 standalone 产物。
# ⚠️ 尚未在本机做 docker build 实测（环境无 Docker）：首次使用请确认 standalone 路径后再切换默认镜像。

ARG NODE_IMAGE=node:24-bookworm-slim

# ============================ 阶段 1：依赖 ============================
FROM ${NODE_IMAGE} AS deps
RUN npm install -g pnpm@11.7.0 --registry=https://registry.npmmirror.com
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY scripts ./scripts
COPY apps/web-overlay/package.json ./apps/web/package.json
COPY packages/core/package.json ./packages/core/
RUN pnpm install --frozen-lockfile --filter "./apps/web"

# ============================ 阶段 2：构建 ============================
FROM ${NODE_IMAGE} AS builder
ARG DEBIAN_MIRROR=deb.debian.org
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tar \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@11.7.0 --registry=https://registry.npmmirror.com
WORKDIR /app
COPY --from=deps /app /app
COPY apps/web-overlay/ ./apps/web-overlay/
# 固定上游 ref、下载重试、overlay 覆写与修剪均由唯一 vendor 入口负责。
# 默认 SHA 只在 vendor 脚本里；build-arg 仅提供可选覆盖，不再复制一份默认值。
ARG NAVSPHERE_REF
RUN NAVSPHERE_REF="$NAVSPHERE_REF" node scripts/vendor-web.mjs
WORKDIR /app/apps/web
# 安全头默认档与 docker/Dockerfile.web 同口径（U-415）：report-only 开 +
# 上报到站内 /api/csp-report，enforce 默认关；HSTS 只声明透传位（默认空，
# 由调用方显式传入，裸构建的 http-only 自托管不被强制升级）。
ARG NAVHUB_CSP=
ARG NAVHUB_CSP_REPORT_ONLY=1
ARG NAVHUB_CSP_REPORT_URI=/api/csp-report
ARG NAVHUB_HSTS=
ENV NODE_ENV=production \
    STORAGE_ADAPTER=http \
    NEXT_PUBLIC_API_URL=http://api:8787 \
    NAVHUB_HOME_CARDS_PER_GROUP=4 \
    NAVHUB_WEB_STANDALONE=1
RUN NAVHUB_CSP="$NAVHUB_CSP" \
    NAVHUB_CSP_REPORT_ONLY="$NAVHUB_CSP_REPORT_ONLY" \
    NAVHUB_CSP_REPORT_URI="$NAVHUB_CSP_REPORT_URI" \
    NAVHUB_HSTS="$NAVHUB_HSTS" \
    pnpm build

# ============================ 阶段 3：运行 ============================
FROM ${NODE_IMAGE} AS runner
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0
# standalone 自带最小 node_modules 与 server.js，不含 pnpm / 源码 / 构建缓存 / 上游 tarball 工具
# 未设 outputFileTracingRoot 时，Next 把 standalone 目录按 workspace 根布局生成：
# /app/server.js + /app/apps/web/.next/... + /app/node_modules（最小闭包）。
COPY --from=builder /app/.next/standalone ./
# session secret 共享卷自举（与默认镜像同口径，但不依赖 pnpm）
COPY docker/entrypoint-web-standalone.sh /usr/local/bin/navhub-web-entrypoint
RUN chmod +x /usr/local/bin/navhub-web-entrypoint \
    && mkdir -p /data && chown -R node:node /data /app
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/ || exit 1
ENTRYPOINT ["/usr/local/bin/navhub-web-entrypoint"]
