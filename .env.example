# ---- 运行模式 ----
NAVHUB_MODE=lite                 # lite | standard
PORT=8787
NAVHUB_PUBLIC_URL=http://localhost:8787
# 生产环境 (NODE_ENV=production) 必须改为 >=32 字符随机串，否则拒绝启动
NAVHUB_SESSION_SECRET=change-me-please-use-a-long-random-string
# 密钥轮换窗口：上一代密钥（轮换期间同时接受新旧签名，新签发只用新密钥；轮换完成删除本行）
# NAVHUB_SESSION_SECRET_PREV=
# 是否信任反向代理的 X-Forwarded-For（默认 false 防公网直连伪造 IP 绕过限流；置于可信反代后请设为 1）
NAVHUB_TRUST_PROXY=0
# navigation.json 单文件快照最大站点数（超限返回 413 引导走分页 API）
NAVHUB_NAVIGATION_MAX_SITES=8000
# 快照读缓存 TTL（毫秒）：0=关闭。任何写请求与库指纹变化都会立即失效，
# TTL 只兜底「另一个进程直接改库」这类绕过 API 的场景。
# 多实例部署（standard）时各实例缓存独立，最长滞后一个 TTL。
NAVHUB_SNAPSHOT_TTL_MS=30000

# ---- 数据库（lite） ----
NAVHUB_SQLITE_PATH=./data/navhub.db

# ---- 数据库（standard） ----
NAVHUB_DATABASE_URL=postgres://navhub:navhub@localhost:5432/navhub

# ---- 本地 embedding ----
NAVHUB_EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
NAVHUB_EMBEDDING_ENDPOINT=https://hf-mirror.com
NAVHUB_EMBEDDING_DTYPE=q8
NAVHUB_EMBEDDING_CACHE=./data/models
NAVHUB_EMBEDDING_DIM=512

# ---- LLM（默认 Agnes 3.0 Flash；缺 Key 时 AI 富化降级为启发式）----
# OpenAI 兼容端点：{baseUrl}/chat/completions
# 管理端 /admin/ai 可覆盖以下配置（密钥加密落库），用户级配置优先于系统级。
NAVHUB_LLM_NAME=Agnes 3.0 Flash
NAVHUB_LLM_BASE_URL=https://api.agnes-ai.cn/v1
NAVHUB_LLM_MODEL=agnes-3.0-flash
NAVHUB_LLM_API_KEY=
NAVHUB_LLM_TIMEOUT_MS=20000
NAVHUB_LLM_MAX_TOKENS=1024
NAVHUB_LLM_TEMPERATURE=0.2
# auto：先带 response_format，不支持时自动去参重试；可选 response_format / prompt
NAVHUB_LLM_JSON_MODE=auto
# 允许 baseUrl 指向内网（本地 Ollama 等）；仅系统级生效，用户级始终禁私网
NAVHUB_LLM_ALLOW_PRIVATE=false
# 可选：独立密钥加密 LLM Key（不设则回退 NAVHUB_SESSION_SECRET；轮换后需重填密钥）
# NAVHUB_SECRETS_KEY=

# ---- REST 鉴权（公开部署时开启；默认关闭=开放模式，行为与历史一致）----
# 开启后：搜索/事件/收藏/投稿等终端功能仍匿名可用；
#         管理面（站点 CRUD/类目/任务/存储写入）必须带 Bearer token（api_tokens 表）
# fail-closed（2026-10-17 起）：NODE_ENV=production 且 NAVHUB_PUBLIC_URL 指向公网
#   且此项为 false → 服务拒绝启动。公网部署请设为 true；
#   内网 / NAS（公网不可达）可显式设 NAVHUB_ALLOW_INSECURE_PUBLIC=1 退回警告。
NAVHUB_AUTH_REQUIRED=false
# 引导 token（一次性）：开启鉴权后用于创建第一个库内 token，用完删除并重启
# NAVHUB_BOOTSTRAP_TOKEN=
# 应急逃生阀：确认公网不可达时可设为 1，仅打印警告不阻断启动（不推荐）
# NAVHUB_ALLOW_INSECURE_PUBLIC=0

# ---- 身份签名（防伪造终端用户身份）----
# 身份标识（userId / anonId）一直是纯字符串：开启鉴权后任何持票人都能自称任意
# 身份读写他人数据（IDOR），开放模式下更是完全无门槛。
# 设为一段随机长密钥（Web 端配同名变量即可；中枢与 Web 共享同一密钥）后：
#   带身份的请求必须携带 x-navhub-identity-signature = HMAC-SHA256(secret, identity)，
#   由 Web 的 /api/hub/* 代理自动计算附带；缺失/错误一律 401。
# 生产环境 NODE_ENV=production 且 NAVHUB_AUTH_REQUIRED=true 时必配：
#   至少 32 个非空白字符，否则中枢拒绝启动。
# 非生产环境或开放模式可选；不配置时保持历史行为。
# NAVHUB_IDENTITY_SECRET=

# ---- 后台登录安全（升级改造方案 P0-2）----
# 生产环境（NODE_ENV=production）下，下列「不安全登录通道」默认全部关闭：
#   - 登录页快捷通道（bypass=true）
#   - 未配置密码时的默认口令（admin / admin123 / navhub / 123456）
# 生产部署请设置 NAVHUB_ADMIN_PASSWORD；确需临时开启不安全通道才设此开关
# （启动时会打印醒目安全警告，仅建议内网/临时调试使用）：
# NAVHUB_ALLOW_DEFAULT_PASSWORD=0

# ---- 后台任务告警（可选；留空则只落 console.error） ----
# 任务重试耗尽时 POST 一条 JSON：{source:"navhub-jobs", text, detail:{kind,attempts,error}, at}
# 飞书/钉钉/自建机器人均可直接接；投递失败不影响任务流
NAVHUB_ALERT_WEBHOOK=
NAVHUB_ALERT_TIMEOUT_MS=5000

# ---- 抓取 ----
NAVHUB_FETCH_TIMEOUT_MS=10000
NAVHUB_FETCH_MAX_BYTES=2097152
NAVHUB_FETCH_MAX_REDIRECTS=3
NAVHUB_ALLOW_PRIVATE_NETWORKS=false

# ---- 前端（apps/web） ----
NEXT_PUBLIC_API_URL=http://localhost:8787
# 站点对外地址：canonical / sitemap / OG 绝对地址的解析基准（src/lib/seo/origin.ts）。
# 必须与中枢地址区分开 —— 不要用 NAVHUB_PUBLIC_URL（那是中枢自己的对外地址）。
# 未设置时会回退到请求头推导，但那样 sitemap/robots/详情页会退化为动态渲染，生产必须设置。
NAVHUB_SITE_URL=http://localhost:3000
STORAGE_ADAPTER=http               # http | github | sqlite
NAVHUB_STORAGE_BASE_URL=           # /api/hub/* 代理的目标中枢；留空则用 NEXT_PUBLIC_API_URL（compose 里为 http://api:8787）
NAVHUB_HUB_TIMEOUT_MS=30000        # 代理上游超时（毫秒）；到点回 504，SSE 长连接不受影响
NEXT_PUBLIC_RUM=0                  # 1=采集 LCP/INP/CLS/TTFB 并上报 /api/hub/api/vitals（不含身份与 query）

# ---- MCP HTTP（packages/mcp/src/http.ts；生产必改） ----
# 对外暴露 MCP 时必须设置 token；仅本地调试可用 ALLOW_INSECURE=true 代替
NAVHUB_MCP_TOKEN=                  # 生产必改：远程 AI 客户端的 Bearer token
NAVHUB_MCP_SCOPES=read,write       # 生产必改：按需收紧（如只读客户端给 read）
NAVHUB_MCP_ALLOW_INSECURE=false    # 生产必改：保持 false；true 仅供本地无 token 调试
NAVHUB_MCP_ALLOWED_ORIGINS=        # 浏览器来源白名单（逗号分隔），为空则拒绝浏览器跨站请求

# ---- 安全与网络（生产必改） ----
NAVHUB_CORS_ORIGINS=*              # 生产必改：收紧为前端域名（如 https://nav.example.com）
# 注：NAVHUB_TRUST_PROXY 与 NAVHUB_DATABASE_URL 已在「运行模式」「数据库(standard)」
#     两节定义，此处不重复；见上文第 10 行与第 22 行的注释。
NAVHUB_STORAGE_TOKEN=              # 生产必改：存储写接口的 Bearer token（http 适配器）
