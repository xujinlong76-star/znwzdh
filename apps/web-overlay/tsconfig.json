{
  "compilerOptions": {
    // 与仓库根 tsconfig.base.json 的 target 对齐。
    // 原来是 Next 模板默认的 es2017，而 lib/video-slide-detector.ts 用了 BigInt 字面量
    // （0n / 1n）做 64 位感知哈希 —— 低于 ES2020 时 tsc 直接报 TS2737（7 处）。
    // 应用本身只跑在现代浏览器与 Node 18+ 上，es2017 只是模板残留，不是真实约束。
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // 允许 `import ... from './x.ts'` 显式后缀（与仓库根 tsconfig.base 的约定一致）。
    // 需要该选项的原因：plugin-manifest-parity.test.ts 等自研测试按仓库统一风格
    // 写 `.ts` 后缀导入，vite/vitest 能解析，tsc 默认会报 TS5097。
    // 前置条件 noEmit 已满足；paths 已改为相对 tsconfig 解析（不再依赖 baseUrl），
    // 为 TS 7 迁移铺路（见 docs/UPGRADE-PROPOSAL-V3-2026-10-19.md）。
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".vercel/output/static/types/**/*.ts",
    "next-env.d.ts",
    ".next*/types/**/*.ts",
    ".next*/dev/types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
