{
  "name": "navhub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "//engines": "基线运行时 Node 24 LTS：CI 与全部 Docker 镜像均为 node:24-bookworm-slim；原生 TypeScript strip-types 自 Node 22.18 起默认开启，已无需 --experimental-strip-types 实验标志。pnpm 由 packageManager 锁定，这里再声明下限防止 corepack 缺失时被旧版安装。",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.7.0"
  },
  "//seed": "必须以仓库根目录为 CWD 运行：config.ts 的 NAVHUB_SQLITE_PATH 默认值是 cwd 相对的 ./data/navhub.db，而 dev-all/Docker 用的是仓库根的 data/navhub.db。此前 `pnpm --filter @navhub/api seed` 以 apps/api 为 CWD，把种子播进了 apps/api/data/navhub.db——开发服务器永远看不到，市场因此像空壳。",
  "scripts": {
    "build": "pnpm -r --filter \"@navhub/*\" build",
    "dev": "node apps/api/src/main.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:web": "node scripts/run.mjs --filter navsphere dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "node scripts/typecheck.mjs",
    "seed": "node apps/api/src/seed-main.ts",
    "mcp:stdio": "pnpm --filter @navhub/mcp start",
    "vendor:web": "node scripts/vendor-web.mjs",
    "test:pg": "node scripts/pg-check.mts",
    "check:overlay": "node scripts/check-web-overlay.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:extensions": "node scripts/check-extensions.mjs",
    "lint": "pnpm --filter navsphere lint",
    "backup": "node scripts/backup.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:all": "node scripts/verify.mjs && pnpm lint && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "22.18.13",
    "esbuild": ">=0.28.1",
    "typescript": "5.9.3",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "5.0.5"
  }
}
