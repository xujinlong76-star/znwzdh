node_modules/
dist/
.next/
out/
*.log
.env
.env.local
# 本地数据目录：**逐个列出**，不用裸 `data/`。
#
# 裸 `data/` 按任意层级匹配，会把 `app/**/data/**` 这类**真实路由目录**静默吞掉：
# 文件在本机存在、能跑，但永远不会进版本库，CI 与生产构建拿不到。
# 已踩两次（/me/data 的 loading.tsx、/admin/data/restore 的 page.tsx），
# 每次都靠「新文件 add 不了」才发现——属于最难自查的一类缺陷。
#
# 现在只忽略这两处运行期数据目录；仓库根与 apps/api 各一个。
# 新增运行期数据目录时请显式加一条，而不是把规则改回去。
/data/
/apps/api/data/
*.db
*.db-journal
*.db-wal
*.db-shm
.research/
.spike/
.cache/
coverage/
test-results/
playwright-report/
*.tsbuildinfo
.DS_Store
Thumbs.db
.trae/

# --- vendored 上游底座（apps/web）---
# apps/web 是 NavSphere 的完整副本，通过 `node scripts/vendor-web.mjs` 拉取，
# 不纳入版本管理：这样本仓库只保留 NavHub 自己的改动，也便于跟进上游更新。
apps/web/*
!apps/web/next.config.js
!apps/web/package.json
!apps/web/UPSTREAM.md
!apps/web/src/

apps/web/src/*
!apps/web/src/lib/
apps/web/src/lib/*
!apps/web/src/lib/github.ts
!apps/web/src/lib/storage-adapter.ts
!apps/web/src/lib/plugins/
apps/web/src/lib/plugins/*
!apps/web/src/lib/plugins/plugin-manifest.ts

# 存储接缝的测试（github.ts / storage-adapter.ts 是 NavHub 自己维护的文件，
# 不是上游代码；根 vitest.config.ts 只放行 apps/web/test 这一个目录）
!apps/web/test/

!apps/web/src/components/
apps/web/src/components/*
!apps/web/src/components/navigation-content.tsx
!apps/web/src/components/search-bar.tsx

!apps/web/src/app/
apps/web/src/app/*
!apps/web/src/app/page.tsx
!apps/web/src/app/videos/
apps/web/src/app/videos/*
!apps/web/src/app/videos/page.tsx

!apps/web/src/app/api/
apps/web/src/app/api/*
!apps/web/src/app/api/search/
apps/web/src/app/api/search/*
!apps/web/src/app/api/search/route.ts

!apps/web/src/app/api/home/
apps/web/src/app/api/home/*
!apps/web/src/app/api/home/navigation/
apps/web/src/app/api/home/navigation/*
!apps/web/src/app/api/home/navigation/route.ts
!apps/web/src/app/api/home/site/
apps/web/src/app/api/home/site/*
!apps/web/src/app/api/home/site/route.ts

# vendor-web.mjs / sync-web-overlay.mjs 的中间产物（正常结束会被脚本自己删掉，失败残留时也不应进仓库）
.vendor-ns*.tgz
.vendor-stage/

.workbuddy/
.workbuddy-ai/

# SEO 巡检临时产物与一次性调试脚本（非交付物，避免误入版本库）
.seo-tmp/
/parity-check.tmp.mjs

# --- 本地 GUI 真人模式测试证据（会话产物，不入库）---
gui-test-screenshots/
