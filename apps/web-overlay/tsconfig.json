{
  "compilerOptions": {
    // 与仓库根 tsconfig.base.json 的 target 对齐。
    // 原来是 Next 模板默认的 es2017，而 lib/video-slide-detector.ts 用了 BigInt 字面量
    // （0n / 1n）做 64 位感知哈希 —— 低于 ES2020 时 tsc 直接报 TS2737（7 处）。
    // 应用本身只跑在现代浏览器与 Node 18+ 上，es2017 只是模板残留，不是真实约束。
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // 允许 `import ... from './x.ts'` 显式后缀（与仓库根 tsconfig.base 的约定一致）。
    // 需要该选项的原因：plugin-manifest-parity.test.ts 等自研测试按仓库统一风格
    // 写 `.ts` 后缀导入，vite/vitest 能解析，tsc 默认会报 TS5097。
    // 前置条件 noEmit 已满足；paths 已改为相对 tsconfig 解析（不再依赖 baseUrl），
    // 为 TS 7 迁移铺路（见 docs/UPGRADE-PROPOSAL-V3-2026-10-19.md）。
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      // 2026-11-21：补 @navhub/* 源码映射。
      // 为什么需要：apps/web-overlay 被 pnpm-workspace.yaml 显式排除
      // （'!apps/web-overlay'，避免 pnpm --filter navsphere 同时命中两个目录），
      // 因此它**无法**用 "workspace:*" 声明 @navhub/core 依赖，
      // node_modules 里也不会有该软链。vitest 靠 vitest.config.ts 的 alias
      // 能解析，但 tsc 只认 tsconfig，于是
      // test/health-state-parity.test.ts:14 报 TS2307。
      // 直接把 @navhub/* 指向 packages/*/src 源码，与 vitest alias 同口径。
      "@navhub/core": [
        "../../packages/core/src/index.ts"
      ],
      "@navhub/core/*": [
        "../../packages/core/src/*"
      ],
      // 2026-11-21：SSRF 出口收口到 packages/ai，web 层改为薄壳 re-export。
      // 与 @navhub/core 同理需要源码映射（该包同样不在 workspace 内）。
      "@navhub/ai/ssrf": [
        "../../packages/ai/src/ssrf.ts"
      ],
      "@navhub/ai/*": [
        "../../packages/ai/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".vercel/output/static/types/**/*.ts",
    "next-env.d.ts",
    // 构建目录的注入类型一律用**单一通配**覆盖（评审 P2-13）：此前 13 个 .next* 目录
    // 各自具名列出，等于把构建期噪音写进事实源 tsconfig —— 新增一个构建目录就要同步
    // 改 overlay 与 web 两份，还会在镜像比对里制造假差异。`.next*` 同时匹配 .next、
    // .next-e2e、.next-prod、.next-gate、.next-e2e-local 等全部现役目录。
    ".next*/types/**/*.ts",
    ".next*/dev/types/**/*.ts",
    ".next-e2e-local/types/**/*.ts",
    ".next-e2e-local/dev/types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
