{
  "name": "@navhub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/main.ts",
    "start": "node dist/main.mjs",
    "start:ts": "node src/main.ts",
    "migrate": "node src/migrate.ts",
    "seed": "node src/seed-main.ts",
    "test": "vitest run --root ../.. --reporter=default --reporter=../../scripts/vitest-github-reporter.mjs apps/api/test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "build": "tsc -p tsconfig.json",
    "bundle": "pnpm exec esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/main.mjs --external:better-sqlite3 --external:sqlite-vec --external:@libsql/client --external:pg --external:onnxruntime-node --external:@huggingface/transformers --external:nodemailer --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --sourcemap --log-level=info",
    "prepublishOnly": "pnpm bundle"
  },
  "dependencies": {
    "@navhub/ai": "workspace:*",
    "@navhub/core": "workspace:*",
    "@navhub/store": "workspace:*",
    "@fastify/cors": "11.4.3",
    "@fastify/rate-limit": "11.3.0",
    "fastify": "5.12.8",
    "sqlite-vec": "0.1.9",
    "better-sqlite3": "13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
