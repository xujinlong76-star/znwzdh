{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // 允许 `import ... from './x.ts'` 显式后缀（与仓库根 tsconfig.base 的约定一致）。
    // 需要该选项的原因：plugin-manifest-parity.test.ts 等自研测试按仓库统一风格
    // 写 `.ts` 后缀导入，vite/vitest 能解析，tsc 默认会报 TS5097。
    // 前置条件 noEmit 已满足；paths 已改为相对 tsconfig 解析（不再依赖 baseUrl），
    // 为 TS 7 迁移铺路（见 docs/UPGRADE-PROPOSAL-V3-2026-10-19.md）。
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      // 前端只映射**纯函数子模块**，不映射整包 barrel：core 的 index 会 re-export
      // 带 node:fs 的实现，整包映射会把 Node 内置模块拖进前端包（turbopack 直接
      // 报 "does not support external modules (node:fs/promises)"）。
      // apps/web 是 vendored 底座、package.json 无该依赖，不映射则 tsc/next build
      // 双双 TS2307 —— 2026-10-27 main 的 5 个 CI 作业同时红即此因。
      "@navhub/core/health-state": [
        "../../packages/core/src/health-state.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".vercel/output/static/types/**/*.ts",
    "next-env.d.ts",
    ".next*/types/**/*.ts",
    ".next*/dev/types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
