# NavHub Web 前端镜像。
#
# 构建期就把 NavSphere 底座拉下来并注入 NavHub 的存储适配器，
# 因此在 Docker 里是**开箱可用**的，不需要先在宿主机跑 vendor 脚本。
#
# 依赖存储 API，所以用 standard profile（与 api 服务同网络）。
# 基础镜像可覆盖（同 Dockerfile.api 的说明）
ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${NODE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tar \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@11.7.0 --registry=https://registry.npmmirror.com

WORKDIR /app

# 1) 依赖层：镜像里前端就是 workspace 成员 apps/web（与仓库同构），直接吃仓库根的
#    pnpm-lock.yaml。先只放清单再装依赖 —— 这一层只随清单/锁文件变化，改自研源码不必重装依赖。
#    frozen 安装 = 镜像里装的就是 CI/仓库锁定的那一套版本（此前 lockfile 没进镜像、只能
#    --no-frozen-lockfile，等于每次构建重新解一遍版本范围，镜像不可复现）。
#    根 workspace 配置同时是 overrides / allowBuilds 的唯一事实源，不需要复制副本或改写。
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# 根 package.json 的 prepare 钩子会执行它（镜像里没有 .git，脚本只打印一行跳过）
COPY scripts/install-git-hooks.mjs ./scripts/
# 覆盖层的清单（vendor 之后它才是最终清单；这里先只放清单供解析）
COPY apps/web-overlay/package.json ./apps/web/package.json
RUN pnpm install --frozen-lockfile --filter "./apps/web"

# 2) 上游底座（NavSphere，MIT）拉进 apps/web，再用 NavHub 覆盖层覆盖存储层
#    默认固定到具体 commit（与 scripts/vendor-web.mjs 的 DEFAULT_REF、UPSTREAM.md 同源），
#    保证同一个仓库标签构建的镜像可复现；升级底座时显式传 --build-arg NAVSPHERE_REF=<新 sha>。
#    codeload 的 /tar.gz/<ref> 对 branch / tag / sha 都有效，故不再拼 refs/heads/。
#    注意：底座 tarball 自带的上游 package.json / pnpm-lock.yaml 会被覆盖层覆盖，
#    镜像里的依赖解析与已装依赖始终以仓库根的清单 + 锁文件为准（见上面第 1 步）。
ARG NAVSPHERE_REF=6ba74fab9f86aa6ba4e276c002128a8f5a0acc0a
RUN curl -fsSL "https://codeload.github.com/tianyaxiang/NavSphere/tar.gz/${NAVSPHERE_REF}" -o /tmp/ns.tgz \
    && mkdir -p /tmp/ns && tar -xzf /tmp/ns.tgz -C /tmp/ns --strip-components=1 \
    && mkdir -p /app/apps/web && cp -a /tmp/ns/. /app/apps/web/ \
    && rm -rf /tmp/ns /tmp/ns.tgz

# 注入 NavHub 的前端覆盖层（唯一事实源：apps/web-overlay/）
#    - src/lib/storage-adapter.ts: 三种后端（http | github | sqlite）的实现
#    - src/lib/github.ts:          保持原函数签名的门面，内部改走适配器。
#                                  因此 NavSphere 那 16 个 route / 约 69 处调用点一行都不用改。
#    - src/lib/navhub-api.ts 等:   混合检索面板 / 收藏夹 / 标签 / 榜单 / 站点详情 /
#                                  后台任务面板与运营看板（第二轮导航增强）
#    - next.config.js:             构建输出目录可覆盖（NEXT_DIST_DIR）
#    注意：/api/hub/* 代理是 src/app/api/hub/[...path]/route.ts 路由（运行时读
#    NAVHUB_STORAGE_BASE_URL），已包含在覆盖层里，无需在 Dockerfile 额外配置。
COPY apps/web-overlay/ /app/apps/web/

WORKDIR /app/apps/web

ENV NODE_ENV=production \
    STORAGE_ADAPTER=http \
    NEXT_PUBLIC_API_URL=http://api:8787

# 生产构建（不使用 standalone：避免 Windows/受限环境下创建符号链接失败）
RUN pnpm build

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/ || exit 1

# 入口负责 session secret 共享自举（与 api 共用 /data/.session-secret，
# 见 entrypoint-web.sh 注释；方案 P0-1），再启动 next start
COPY docker/entrypoint-web.sh /usr/local/bin/navhub-web-entrypoint
RUN chmod +x /usr/local/bin/navhub-web-entrypoint
ENTRYPOINT ["/usr/local/bin/navhub-web-entrypoint"]
