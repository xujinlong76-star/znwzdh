# NavHub Web 前端镜像。
#
# 构建期就把 NavSphere 底座拉下来并注入 NavHub 的存储适配器，
# 因此在 Docker 里是**开箱可用**的，不需要先在宿主机跑 vendor 脚本。
#
# 依赖存储 API，所以用 standard profile（与 api 服务同网络）。
# 基础镜像可覆盖（同 Dockerfile.api 的说明）
ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tar \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@11.7.0 --registry=https://registry.npmmirror.com

WORKDIR /app

# 1) 依赖层：镜像里前端就是 workspace 成员 apps/web（与仓库同构），直接吃仓库根的
#    pnpm-lock.yaml。先只放清单再装依赖 —— 这一层只随清单/锁文件变化，改自研源码不必重装依赖。
#    frozen 安装 = 镜像里装的就是 CI/仓库锁定的那一套版本（此前 lockfile 没进镜像、只能
#    --no-frozen-lockfile，等于每次构建重新解一遍版本范围，镜像不可复现）。
#    根 workspace 配置同时是 overrides / allowBuilds 的唯一事实源，不需要复制副本或改写。
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# 根 package.json 的 prepare 钩子会执行它（镜像里没有 .git，脚本只打印一行跳过）
COPY scripts/install-git-hooks.mjs ./scripts/
# 它的相对 import 闭包（scripts/lib/hooks-fresh.mjs）同样要进镜像；漏拷 = prepare 阶段直接失败。
COPY scripts/lib/hooks-fresh.mjs ./scripts/lib/
# 覆盖层的清单（vendor 之后它才是最终清单；这里先只放清单供解析）
COPY apps/web-overlay/package.json ./apps/web/package.json
RUN pnpm install --frozen-lockfile --filter "./apps/web"

# 2) 上游底座（NavSphere，MIT）拉进 apps/web，再用 NavHub 覆盖层覆盖存储层
#    默认固定到具体 commit（与 scripts/vendor-web.mjs 的 DEFAULT_REF、UPSTREAM.md 同源），
#    保证同一个仓库标签构建的镜像可复现；升级底座时显式传 --build-arg NAVSPHERE_REF=<新 sha>。
#    codeload 的 /tar.gz/<ref> 对 branch / tag / sha 都有效，故不再拼 refs/heads/。
#    注意：底座 tarball 自带的上游 package.json / pnpm-lock.yaml 会被覆盖层覆盖，
#    镜像里的依赖解析与已装依赖始终以仓库根的清单 + 锁文件为准（见上面第 1 步）。
ARG NAVSPHERE_REF=6ba74fab9f86aa6ba4e276c002128a8f5a0acc0a
# codeload 在 CI 上偶发 TLS 超时 / 连接重置（scripts/vendor-web.mjs 也遇到过，那边已有
# 60s 超时 + 3 次重试）。没有超时/重试的 curl 会一直挂着，直到撞上 job 的 30 分钟超时，
# 日志里只剩一句超时、看不出真正原因。这里补齐同样的语义：连接超时 10s、单次总计 300s、
# 瞬时错误重试 3 次；坏 ref（404）等确定性错误不重试，直接快速失败。
RUN curl -fsSL --connect-timeout 10 --max-time 300 --retry 3 --retry-delay 2 --retry-connrefused \
      "https://codeload.github.com/tianyaxiang/NavSphere/tar.gz/${NAVSPHERE_REF}" -o /tmp/ns.tgz \
    && mkdir -p /tmp/ns && tar -xzf /tmp/ns.tgz -C /tmp/ns --strip-components=1 \
    && mkdir -p /app/apps/web && cp -a /tmp/ns/. /app/apps/web/ \
    && rm -rf /tmp/ns /tmp/ns.tgz

# 注入 NavHub 的前端覆盖层（唯一事实源：apps/web-overlay/）
#    - src/lib/storage-adapter.ts: 三种后端（http | github | sqlite）的实现
#    - src/lib/github.ts:          保持原函数签名的门面，内部改走适配器。
#                                  因此 NavSphere 那 16 个 route / 约 69 处调用点一行都不用改。
#    - src/lib/navhub-api.ts 等:   混合检索面板 / 收藏夹 / 标签 / 榜单 / 站点详情 /
#                                  后台任务面板与运营看板（第二轮导航增强）
#    - next.config.js:             构建输出目录可覆盖（NEXT_DIST_DIR）
#    注意：/api/hub/* 代理是 src/app/api/hub/[...path]/route.ts 路由（运行时读
#    NAVHUB_STORAGE_BASE_URL），已包含在覆盖层里，无需在 Dockerfile 额外配置。
COPY apps/web-overlay/ /app/apps/web/

# 3) 修剪上游遗留文件（与 scripts/vendor-web.mjs 的 prune 列表保持一致）
#    Next 16 起 middleware 更名为 proxy；上游 tarball 仍带 src/middleware.ts，
#    与覆盖层的 src/proxy.ts 并存会让 next build 直接报错
#    ("Both middleware file ... and proxy file ... are detected")。
#    vendor 脚本在宿主机已修剪，但镜像构建不跑 vendor —— 必须在这里同步修剪。
RUN rm -f /app/apps/web/src/middleware.ts /app/apps/web/.eslintrc.json

WORKDIR /app/apps/web

# CSP 开关是构建期变量：Next 的 headers() 在 next build 时写入 routes-manifest，
# 运行时改 env 不会生效。需要 CSP 的镜像用：
#   docker build --build-arg NAVHUB_CSP=1 -f docker/Dockerfile.web .
# report-only 档：--build-arg NAVHUB_CSP_REPORT_ONLY=1 [--build-arg NAVHUB_CSP_REPORT_URI=https://...]
ARG NAVHUB_CSP=
ARG NAVHUB_CSP_REPORT_ONLY=
ARG NAVHUB_CSP_REPORT_URI=

# 首页 HTML 预算（4096KB 哨兵）：全量 443 卡时实测 4617KB，超预算 521KB。
# app/page.tsx 支持用 NAVHUB_HOME_CARDS_PER_GROUP 控制每组 SSR 卡片数；实测每组 4 张后
# 首页 3502KB（-1115KB，留 594KB 余量）。折叠卡片在客户端即时展开（数据随 props 下发，
# 零请求、无加载态），不损失功能。该值必须固化在构建期（next build 时被读取）。
ENV NODE_ENV=production \
    STORAGE_ADAPTER=http \
    NEXT_PUBLIC_API_URL=http://api:8787 \
    NAVHUB_HOME_CARDS_PER_GROUP=4

# ---- 镜像链的类型 / lint 判定去了哪里（显式声明，不是遗漏）----
# 本镜像只跑一条 pnpm build；next.config.js 的 typescript.ignoreBuildErrors=false
# 是 2026-11-09 S-6 有意恢复的类型门禁（若再引入类型错误应修类型而不是关开关），
# 所以 next build 会在镜像内做类型检查。全量 typecheck 仍在 CI 的 test-web 作业里复核：
#     pnpm --filter navsphere exec tsc --noEmit        （step id: web-typecheck）
#     pnpm --filter navsphere exec eslint . --max-warnings 316
# 在镜像层重跑这两条会引入两个新风险：tsc 要等 next build 生成 next-env.d.ts 与
# .next/types，顺序错了就是假红；eslint 会把上游 tarball 的文件一起纳入，告警基线
# 与仓库里那条 --max-warnings 316 不是同一套。所以这里选「显式信任 + 机器校验」：
# 下面这行锚点由 scripts/check-ci-gate.mjs 第 8 项双向核对——Dockerfile 缺它、
# 或它指向的步骤在 ci.yml 里消失 / 不再含 tsc --noEmit，都直接判红。
# 注意：overlay 的 test/ 不进镜像（见 .dockerignore）——其中一致性校验测试相对
# 引用 ../../../packages/* 源码，而生产镜像不含 packages/；test/ 进镜像会在 4 处
# 报 TS2307 打断构建。test/ 的类型由 CI 的 web-typecheck（仓库内 tsc）把关。
# NAVHUB-TYPE-TRUST: test-web/web-typecheck

# 生产构建（不使用 standalone：避免 Windows/受限环境下创建符号链接失败）
RUN NAVHUB_CSP="$NAVHUB_CSP" \
    NAVHUB_CSP_REPORT_ONLY="$NAVHUB_CSP_REPORT_ONLY" \
    NAVHUB_CSP_REPORT_URI="$NAVHUB_CSP_REPORT_URI" \
    pnpm build

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/ || exit 1

# 入口负责 session secret 共享自举（与 api 共用 /data/.session-secret，
# 见 entrypoint-web.sh 注释；方案 P0-1），再启动 next start
COPY docker/entrypoint-web.sh /usr/local/bin/navhub-web-entrypoint
RUN chmod +x /usr/local/bin/navhub-web-entrypoint

# ---- 最小权限运行 ----
# 此前整个镜像以 root 跑 next start：前端一旦被 RCE 就是容器内 root，而它还挂着
# 与中枢共享的 navhub-data 卷（可写 → 能改 navhub.db、也能改 /data/.session-secret
# 给自己签一个合法 session）。与 Dockerfile.api 用同一个 node 身份。
RUN mkdir -p /data && chown -R node:node /data /app
USER node

ENTRYPOINT ["/usr/local/bin/navhub-web-entrypoint"]
