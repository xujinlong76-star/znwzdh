{
  "name": "navhub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r --filter \"@navhub/*\" build",
    "dev": "pnpm --filter @navhub/api dev",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:web": "node scripts/run.mjs --filter navsphere dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --filter \"@navhub/*\" exec tsc --noEmit",
    "seed": "pnpm --filter @navhub/api seed",
    "mcp:stdio": "pnpm --filter @navhub/mcp start",
    "vendor:web": "node scripts/vendor-web.mjs",
    "test:pg": "node --experimental-strip-types scripts/pg-check.mts",
    "check:overlay": "node scripts/check-web-overlay.mjs",
    "backup": "node scripts/backup.mjs",
    "verify": "node scripts/check-web-overlay.mjs && pnpm -r --filter \"@navhub/*\" exec tsc --noEmit && vitest run",
    "verify:all": "node scripts/check-web-overlay.mjs && pnpm -r --filter \"@navhub/*\" exec tsc --noEmit && vitest run && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "22.18.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
