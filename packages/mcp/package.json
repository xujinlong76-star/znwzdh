{
  "name": "@navhub/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/tools.ts",
      "default": "./src/tools.ts"
    }
  },
  "bin": {
    "navhub-mcp": "./src/stdio.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/stdio.ts",
    "http": "node --experimental-strip-types src/http.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@navhub/api": "workspace:*",
    "@navhub/core": "workspace:*",
    "@navhub/store": "workspace:*",
    "@navhub/ai": "workspace:*",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
