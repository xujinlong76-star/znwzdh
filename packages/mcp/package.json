{
  "name": "@navhub/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/tools.ts",
      "default": "./src/tools.ts"
    }
  },
  "bin": {
    "navhub-mcp": "./src/stdio.ts"
  },
  "scripts": {
