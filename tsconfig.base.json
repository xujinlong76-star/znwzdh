{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // 全仓统一用显式 .ts 后缀导入（Node 的 --experimental-strip-types 直接跑源码所需）
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    // 原生依赖（sqlite-vec）没有类型声明，自定义 ambient 声明放在仓库根 types/
    "typeRoots": ["./types", "./node_modules/@types"],
    // TS 7 不再默认注入所有 @types；显式声明全局 Node 类型（Buffer/URL/TextDecoder 等）。
    "types": ["node"]
  },
  // 排除说明：
  //  - scripts/         本地验证脚手架（pg-check 等），连真实数据库、依赖运行时环境变量
  //  - apps/web         vendored 的上游底座（有自己的 tsconfig 与 Next 构建流程）
  //  - apps/web-overlay NavHub 自研前端覆盖层，由 vendor 脚本合并进 apps/web 后
  //                     由 Next 编译；它本身没有 package.json / React 类型，
  //                     放在根 tsconfig 里直接检查会因缺少 jsx 与 react 类型而报错
  //  - extensions/      浏览器扩展与 Raycast 扩展：各有自己的构建链与宿主类型
  //                     （@raycast/api、chrome 类型），不属于本仓根的编译范围
  //  - **/test/**       测试代码不受 noUncheckedIndexedAccess 的严格下标检查约束
  //                     （测试里大量 __proto__/字面量下标访问，收紧会产出噪音而非真问题）；
  //                     测试由 vitest 负责编译与运行
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    "data",
    "scripts",
    "apps/web",
    "apps/web-overlay",
    "extensions",
    "packages/*/test",
    "apps/api/test"
  ]
}
