# NavHub 中枢服务镜像（默认 lite 模式：SQLite + sqlite-vec + FTS5）
#
# 两个可覆盖的构建参数，用于 Docker Hub / deb.debian.org 不可达的网络：
#   --build-arg NODE_IMAGE=dockerproxy.net/library/node:22-bookworm-slim
#   --build-arg DEBIAN_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG NODE_IMAGE=node:22-bookworm-slim
ARG DEBIAN_MIRROR=deb.debian.org

# ============================ 阶段 1：依赖 ============================
# better-sqlite3 需要编译原生扩展（python3/make/g++），这套编译链**只留在构建阶段**，
# 运行镜像里不再有它（升级建议：镜像瘦身 + 减小攻击面）。
# 先按需把 APT 源指向可用镜像，再安装 —— 否则在部分网络下 apt update 会因
# deb.debian.org 被中断而直接失败（实测错误：connection forcibly closed）。
FROM ${NODE_IMAGE} AS deps
ARG DEBIAN_MIRROR
RUN set -eux; \
    if [ "$DEBIAN_MIRROR" != "deb.debian.org" ]; then \
      if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s|deb.debian.org|$DEBIAN_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
      fi; \
      if [ -f /etc/apt/sources.list ]; then \
        sed -i "s|deb.debian.org|$DEBIAN_MIRROR|g" /etc/apt/sources.list; \
      fi; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends python3 make g++ ca-certificates curl; \
    rm -rf /var/lib/apt/lists/*

# pnpm：不依赖 corepack（corepack 会联网拉取指定版本，构建环境常不可用）
RUN npm install -g pnpm@11.7.0 --registry=https://registry.npmmirror.com

WORKDIR /app

# 先只拷贝清单，最大化利用层缓存
COPY package.json pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY packages/core/package.json ./packages/core/
COPY packages/store/package.json ./packages/store/
COPY packages/ai/package.json ./packages/ai/
COPY packages/mcp/package.json ./packages/mcp/
COPY apps/api/package.json ./apps/api/

RUN pnpm install --frozen-lockfile

COPY packages ./packages
COPY apps/api ./apps/api
COPY types ./types

# ============================ 阶段 2：运行 ============================
# 只保留运行时需要的 ca-certificates + curl（HEALTHCHECK 用），不带编译链。
FROM ${NODE_IMAGE}
ARG DEBIAN_MIRROR
RUN set -eux; \
    if [ "$DEBIAN_MIRROR" != "deb.debian.org" ]; then \
      if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s|deb.debian.org|$DEBIAN_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
      fi; \
      if [ -f /etc/apt/sources.list ]; then \
        sed -i "s|deb.debian.org|$DEBIAN_MIRROR|g" /etc/apt/sources.list; \
      fi; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
# 依赖产物（含已编译的 better-sqlite3 / onnxruntime 平台二进制）随源码一起搬过来。
# 两个阶段用的是同一个基础镜像，平台二进制可直接复用。
COPY --from=deps /app /app

ENV NODE_ENV=production \
    NAVHUB_MODE=lite \
    NAVHUB_SQLITE_PATH=/data/navhub.db \
    NAVHUB_EMBEDDING_CACHE=/data/models \
    PORT=8787

VOLUME ["/data"]
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8787/api/health || exit 1

# 入口负责可选的种子导入，再启动服务（只用到 node，不需要 pnpm）
COPY docker/entrypoint.sh /usr/local/bin/navhub-entrypoint
RUN chmod +x /usr/local/bin/navhub-entrypoint

# ---- 最小权限运行 ----
# /data 预先 chown 给 node（SQLite/embedding 缓存要写这里），
# /app 只读即可（node_modules 与源码运行时不需要写）。
RUN mkdir -p /data && chown -R node:node /data /app
USER node

ENTRYPOINT ["/usr/local/bin/navhub-entrypoint"]
