{
  "name": "navhub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "//engines": "实际强依赖 Node 22：docker/entrypoint.sh 与多个脚本使用 --experimental-strip-types（22.6+），CI/Docker 镜像也是 node:22。pnpm 由 packageManager 锁定，这里再声明下限防止 corepack 缺失时被旧版安装。",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.7.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"@navhub/*\" build",
    "dev": "pnpm --filter @navhub/api dev",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:web": "node scripts/run.mjs --filter navsphere dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --filter \"@navhub/*\" exec tsc --noEmit",
    "seed": "pnpm --filter @navhub/api seed",
    "mcp:stdio": "pnpm --filter @navhub/mcp start",
    "vendor:web": "node scripts/vendor-web.mjs",
    "test:pg": "node --experimental-strip-types scripts/pg-check.mts",
    "check:overlay": "node scripts/check-web-overlay.mjs",
    "check:extensions": "node scripts/check-extensions.mjs",
    "lint": "pnpm --filter navsphere lint",
    "backup": "node scripts/backup.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:all": "node scripts/verify.mjs && pnpm lint && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "22.18.13",
    "esbuild": ">=0.28.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
