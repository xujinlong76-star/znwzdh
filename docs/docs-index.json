  "scripts": {
    "checkMjs": [
      {
        "file": "check-isr-routes.mjs",
        "purpose": "ISR 路由门禁：构建产物 + --live 线上形态抽查，防 Next 16 读 searchParams 触发 DYNAMIC_SERVER_USAGE 500"
      },
      {
        "file": "check-upstream-ref.mjs",
        "purpose": "上游底座 ref 一致性：DEFAULT_REF / Dockerfile ARG / UPSTREAM.md / compose build arg 四处同源"
      },
      {
        "file": "check-extensions.mjs",
        "purpose": "浏览器与桌面扩展规范性：Chrome MV3 清单/资源/JS 语法 + Raycast 包规范与入口"
      },
      {
        "file": "check-syntax.mjs",
        "purpose": "语法快速门禁：用 esbuild 秒级解析 TS/TSX（不依赖 tsc 项目配置，与 TS 7 解耦）"
      },
      {
        "file": "check-large-files.mjs",
        "purpose": "大文件入库守卫：--staged 默认 50 MiB / --unpushed 扫未推送 blob，防 100 MiB 推送被拒"
      },
      {
        "file": "check-committed-refs.mjs",
        "purpose": "提交完整性：已跟踪文件不得引用未入库文件（仓库内相对引用 / package.json 的 node scripts/x.mjs）"
      },
      {
        "file": "check-client-node-imports.mjs",
        "purpose": "客户端模块图不得 import node 内建模块（防 'use client' 把 crypto/buffer 打进首屏）"
      },
      {
        "file": "check-core-mirrors.mjs",
        "purpose": "core 镜像一致性：读 HEAD 提交内容，防 packages/core 改了而 overlay 镜像没重生成"
      },
      {
        "file": "check-component-contracts.mjs",
        "purpose": "组件 props 契约静态检查：调用点多传未声明属性 / 必填属性全没传（正则，非 AST）"
      },
      {
        "file": "check-gates-registry.mjs",
        "purpose": "门禁清单对账：scripts/gates.json ↔ pre-commit ↔ pre-push ↔ ci.yml 三向一致"
      },
      {
        "file": "check-hooks-fresh.mjs",
        "purpose": "钩子新鲜度：.git/hooks 生成物仍是 install-git-hooks.mjs 的产物（仅 pre-commit 跑）"
      },
      {
        "file": "check-commit-closure.mjs",
        "purpose": "提交闭包：按「HEAD 缺了哪些符号」判定一组文件能否作为完整提交（少文件 / 多带别人半成品）"
      },
      {
        "file": "check-rate-limit-exemption.mjs",
        "purpose": "限流豁免集成覆盖：预览站上 A/B 验证 SSR 取数不再 429 降级成 noindex 壳"
      },
      {
        "file": "check-bundle-budget.mjs",
        "purpose": "首屏 JS 预算：从构建产物静态统计路由初始 chunk（扣除异步 chunk / polyfills）"
      },
      {
        "file": "check-cleanup-coverage.mjs",
        "purpose": "清理动作覆盖每条出口（登记制 CLEANUP_RULES），尤其提前 return 绕过 finally"
      },
      {
        "file": "check-source-truth.mjs",
        "purpose": "读路径事实源判据必须是显式开关（如 resolveVideoStoreMode() === 'db'），不许按哪边数据多"
      },
      {
        "file": "check-deps-integrity.mjs",
        "purpose": "依赖完整性：抓 pnpm Windows EPERM 安装半途而废导致的「被装残的包」"
      },
      {
        "file": "check-defused-thickness.mjs",
        "purpose": "撤防账厚度棘轮：比对 explain-ci-failure --defused --json 快照的道数，防写侧漏登记"
      },
      {
        "file": "check-web-overlay.mjs",
        "purpose": "apps/web 与 apps/web-overlay 一致性：正向漂移失败 exit 1，反向只告警（可选 --fix）"
      },
      {
        "file": "check-search-recall.mjs",
        "purpose": "检索召回回归器：起盘上引擎 + 临时库副本，重放金标集之外的「召不回来」缺陷探针"
      },
      {
        "file": "check-rest-contract-coverage.mjs",
        "purpose": "REST 契约覆盖率：路由表 ↔ RESPONSE_SCHEMA_BINDINGS 对账，写路由 100% 绑定或进 allowlist"
      },
      {
        "file": "check-commit-atomicity.mjs",
        "purpose": "提交原子性：本次提交的测试不得依赖「脏了但没提交」的源码 / 非代码文件"
      },
      {
        "file": "check-import-boundaries.mjs",
        "purpose": "依赖边界：规则表化「谁能 import 谁」，防 overlay 直接 import @navhub/core 在镜像里 TS2307"
      },
      {
        "file": "check-sparsity.mjs",
        "purpose": "分类稀疏度巡检：拉 :8787 /api/categories 与 counts，核验 18 根 / 215 叶站点数 ≥20 达标率并抽查权重排序"
      },
      {
        "file": "check-ci-gate.mjs",
        "purpose": "CI 合并门禁离线校验：解析 ci.yml 全部 jobs 与 ci-passed 的 needs 聚合关系并断言"
      },
      {
        "file": "check-coverage.mjs",
        "purpose": "覆盖率取数：只读 vitest JSON，出数 / --thresholds 判红 / --max-age 防旧数据假绿"
      },
      {
        "file": "check-plan-status.mjs",
        "purpose": "计划项 → 落地证据收口：按符号名 / 特征字符串判定 docs/plan-status.json 的 landed 证据"
      },
      {
        "file": "check-env-surface.mjs",
        "purpose": "配置面登记棘轮：process.env.NAVHUB_* 新增未登记变量判红（against scripts/env-surface.json）"
      },
      {
        "file": "check-audit-exceptions.mjs",
        "purpose": "依赖审计例外到期：ghsa/reason/owner/expiresAt 齐全，过期判红，可 --emit-ignore"
      },
      {
        "file": "check-governance.mjs",
        "purpose": "治理门禁聚合器：把 plan-status / env-surface / audit-exceptions 三条单一事实源合成 verify 一步"
      }
    ]
  }
}
