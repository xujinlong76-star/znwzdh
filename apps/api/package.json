{
  "name": "@navhub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types src/main.ts",
    "start": "node dist/main.mjs",
    "start:ts": "node --experimental-strip-types src/main.ts",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "seed": "node --experimental-strip-types src/seed-main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "bundle": "pnpm exec esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.mjs --external:better-sqlite3 --external:sqlite-vec --external:@libsql/client --external:pg --external:onnxruntime-node --external:@huggingface/transformers --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --sourcemap --log-level=info",
    "prepublishOnly": "pnpm bundle"
  },
  "dependencies": {
    "@navhub/ai": "workspace:*",
    "@navhub/core": "workspace:*",
    "@navhub/store": "workspace:*",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "fastify": "5.12.7",
    "sqlite-vec": "0.1.9",
    "better-sqlite3": "13.0.3",
    "zod": "^4.6.7",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
