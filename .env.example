# ---- 运行模式 ----
NAVHUB_MODE=lite                 # lite | standard
PORT=8787
NAVHUB_PUBLIC_URL=http://localhost:8787
NAVHUB_SESSION_SECRET=change-me-please-use-a-long-random-string

# ---- 数据库（lite） ----
NAVHUB_SQLITE_PATH=./data/navhub.db

# ---- 数据库（standard） ----
NAVHUB_DATABASE_URL=postgres://navhub:navhub@localhost:5432/navhub

# ---- 本地 embedding ----
NAVHUB_EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
NAVHUB_EMBEDDING_ENDPOINT=https://hf-mirror.com
NAVHUB_EMBEDDING_DTYPE=q8
NAVHUB_EMBEDDING_CACHE=./data/models
NAVHUB_EMBEDDING_DIM=512

# ---- LLM（可选；缺省时 AI 富化降级为启发式） ----
NAVHUB_LLM_BASE_URL=https://api.deepseek.com
NAVHUB_LLM_API_KEY=
NAVHUB_LLM_MODEL=deepseek-chat

# ---- 抓取 ----
NAVHUB_FETCH_TIMEOUT_MS=10000
NAVHUB_FETCH_MAX_BYTES=2097152
NAVHUB_FETCH_MAX_REDIRECTS=3
NAVHUB_ALLOW_PRIVATE_NETWORKS=false

# ---- 前端（apps/web） ----
NEXT_PUBLIC_API_URL=http://localhost:8787
STORAGE_ADAPTER=http               # http | github | sqlite
