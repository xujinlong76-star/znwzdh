{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // 允许 `import ... from './x.ts'` 显式后缀（与仓库根 tsconfig.base 的约定一致）。
    // 需要该选项的原因：plugin-manifest-parity.test.ts 等自研测试按仓库统一风格
    // 写 `.ts` 后缀导入，vite/vitest 能解析，tsc 默认会报 TS5097。
    // 前置条件 noEmit 已满足；TS 7 起 baseUrl/moduleResolution:node 将被移除，
    // 迁移时与升级批次一并处理（见 docs/UPGRADE-PROPOSAL-V3-2026-10-19.md）。
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".vercel/output/static/types/**/*.ts",
    "next-env.d.ts",
    ".next-verify/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
