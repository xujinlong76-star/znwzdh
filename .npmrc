# 使用国内镜像：registry.npmjs.org 在本机频繁超时（onnxruntime-node 体积大尤其明显）
registry=https://registry.npmmirror.com

# 大包（onnxruntime-node 约数百 MB）需要更长的下载窗口
fetch-timeout=600000
fetch-retries=5
fetch-retry-maxtimeout=180000

# 保持 pnpm 默认的严格 peer 依赖处理
strict-peer-dependencies=false

# 供应链延迟防护：只安装发布时间超过 24h 的版本，挡住「刚发布即被投毒」的窗口
# （真实案例：event-stream / chalk 类都是发布数小时内被大规模安装的）。
# 例外清单在 pnpm-workspace.yaml 的 minimumReleaseAgeExclude（当前只有 next 15.5.28
# 的 9 个平台包——它被 backport 标签固定，不含未来补丁，故需解除延迟）。
# frozen-lockfile 安装使用锁定的精确版本，不受本项影响；仅在解析新版本时生效。
minimumReleaseAge=1440
